{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "v19-plus",
    "public": "apps/web/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.m3u8",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Content-Type", "value": "application/x-mpegURL" }
        ]
      },
      {
        "source": "**/*.ts",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Content-Type", "value": "video/mp2t" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/hls/**",
        "destination": "https://storage.googleapis.com/v19-plus.firebasestorage.app/hls/**"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
