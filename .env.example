# ============================================================
# V19PLUS ENVIRONMENT CONFIGURATION TEMPLATE
# Region: Singapore (Locked Primary Infrastructure Region)
# ============================================================

# Environment: development | staging | production
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# ------------------------------------------------------------
# PostgreSQL Database (Render Singapore)
# ------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://v19plus_admin:v19plus_password@localhost:5432/v19plus_db
DATABASE_SYNC_URL=postgresql://v19plus_admin:v19plus_password@localhost:5432/v19plus_db

# ------------------------------------------------------------
# Render Key-Value / Redis (Singapore)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# JWT Authentication & Tokens
# ------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_cryptographically_secure_random_string_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# Video Playback Security (HMAC Signed Tokens for CDN)
# ------------------------------------------------------------
PLAYBACK_TOKEN_SECRET=replace_with_playback_token_signing_secret_min_32_chars
PLAYBACK_TOKEN_EXPIRE_MINUTES=30
CDN_STREAMING_BASE_URL=https://stream.v19plus.com

# ------------------------------------------------------------
# Cloudflare R2 Object Storage (S3 Compatible)
# ------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_MASTERS_BUCKET=v19plus-masters
R2_STREAMING_BUCKET=v19plus-streaming
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# ------------------------------------------------------------
# Indian Payment Gateway: Razorpay (Server-Side Verified)
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# ------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------
# CORS Allowed Origins (Comma separated)
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://v19plus.com,https://admin.v19plus.com,capacitor://localhost
