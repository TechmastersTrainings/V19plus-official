rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() || request.auth != null || request.auth.token.email == 'v19plus04@gmail.com';
    }

    // Public streaming and media read for player
    match /{allPaths=**} {
      allow read: if true;
    }

    // Transcoded HLS Stream Storage Rules
    match /hls/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Video Storage Rules (Direct Resumable Uploads)
    match /videos/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Thumbnail Storage Rules
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Uploads fallback directory
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write, delete: if true;
    }
  }
}
